[Unit]
Description=Unspace Drone Dock Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=railgenie
Group=railgenie
WorkingDirectory=/opt/unspace/drone-dock-agent
Environment=DRONE_DOCK_CONFIG_PATH=/etc/unspace/drone-dock-agent.config.json
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/unspace/drone-dock-agent/.venv/bin/drone-dock-agent --healthcheck
ExecStart=/opt/unspace/drone-dock-agent/.venv/bin/drone-dock-agent
ExecStartPost=/bin/bash -lc '/opt/unspace/drone-dock-agent/.venv/bin/drone-dock-agent --healthcheck'
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/tmp /var/lib/drone-dock/uploads

# Logs (journalctl -u drone-dock-agent)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drone-dock-agent

[Install]
WantedBy=multi-user.target
